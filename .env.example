# ── Postgres ─────────────────────────────────────────────────────────────────
# Needs pgvector + pg_textsearch extensions installed
# Tiger Data cloud: https://console.cloud.timescale.com (free tier available)
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/docchat

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# For OpenAI embeddings (dim=1536):
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.7    # 0.7 = 70% vector, 30% BM25
RELEVANCE_THRESHOLD=0.30

# ── Local LLM (no API key) ────────────────────────────────────────────────────
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=mistral
